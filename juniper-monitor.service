[Unit]
Description=Juniper Switch Monitor
After=network.target

[Service]
Type=simple
User=appuser
WorkingDirectory=/opt/juniper-monitor
Environment="JMON_HOME=/opt/juniper-monitor/data"
ExecStart=/opt/juniper-monitor/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
